{
  "name": "scratchpy-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "ScratchPy Studio — Scratch 3 (.sb3) と ScratchPy を双方向変換する初心者向け Web ツール（Studio / Education、日英）",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && node scripts/build-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ja": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:en": "VITE_APP_LANGUAGE=en vite --host 0.0.0.0 --port 5174 --strictPort",
    "start:both": "bash scripts/start-both.sh",
    "build:en": "VITE_APP_LANGUAGE=en tsc -b && VITE_APP_LANGUAGE=en VITE_APP_BASE=${VITE_APP_BASE:-./} vite build --outDir artifacts/en",
    "dev:education": "VITE_APP_EDUCATION=true vite --host 0.0.0.0 --port 5175 --strictPort",
    "build:education": "VITE_APP_EDUCATION=true tsc -b && VITE_APP_EDUCATION=true VITE_APP_BASE=${VITE_APP_BASE:-./} vite build --outDir artifacts/education",
    "start:education": "bash scripts/start-education.sh",
    "start:all": "bash scripts/start-all.sh",
    "dev:education:en": "VITE_APP_EDUCATION=true VITE_APP_LANGUAGE=en vite --host 0.0.0.0 --port 5176 --strictPort",
    "build:education:en": "VITE_APP_EDUCATION=true VITE_APP_LANGUAGE=en tsc -b && VITE_APP_EDUCATION=true VITE_APP_LANGUAGE=en VITE_APP_BASE=${VITE_APP_BASE:-./} vite build --outDir artifacts/education-en",
    "start:education:en": "bash scripts/start-education-en.sh",
    "build:ja": "tsc -b && VITE_APP_BASE=${VITE_APP_BASE:-./} vite build --outDir artifacts/ja",
    "build:pages": "npm run build",
    "preview:pages": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "start:pages": "node scripts/start-pages.mjs",
    "smoke": "node scripts/smoke-browser.cjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:contrast": "node scripts/check-contrast.cjs",
    "check:colours": "node scripts/check-colour-modes.cjs",
    "check:theme": "node scripts/check-theme-init.cjs",
    "check": "node scripts/check-editions.mjs && node scripts/check-headers.mjs && node scripts/check-css-vars.mjs && vitest run",
    "check:editions": "node scripts/check-editions.mjs",
    "check:cssvars": "node scripts/check-css-vars.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name scratchpy-studio --branch main",
    "deploy:preview": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name scratchpy-studio --branch preview"
  },
  "dependencies": {
    "@turbowarp/scaffolding": "0.4.0",
    "blockly": "^12.5.1",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@turbowarp/scaffolding": {
      "@turbowarp/types": "0.0.15"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ukprmenbersaku-abc/scratchpy-studio.git"
  },
  "homepage": "https://github.com/ukprmenbersaku-abc/scratchpy-studio#readme"
}
